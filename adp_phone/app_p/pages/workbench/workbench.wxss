.workbench-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--color-bg-secondary);
}

/* Header */
.wb-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 32rpx 32rpx;
  background: var(--color-bg-primary);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.wb-greeting {
  display: flex;
  flex-direction: column;
}

.wb-hello {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.wb-role {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

.wb-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wb-avatar text {
  color: #FFFFFF;
  font-size: var(--font-lg);
  font-weight: 600;
}

/* KPI Grid */
.kpi-grid {
  margin: 0 32rpx;
}

.kpi-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
}

.kpi-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.kpi-label {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

/* Quick Actions */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  margin: 0 32rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.quick-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.quick-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.quick-icon-feed { background: #E3F2FD; }
.quick-icon-patrol { background: #E8F5E9; }
.quick-icon-material { background: #FFF3E0; }
.quick-icon-photo { background: #F3E5F5; }

.quick-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* Task List */
.task-list {
  padding: 0 32rpx;
}

.task-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.task-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.task-status-pending { background: var(--color-warning); }
.task-status-in_progress { background: var(--color-primary); }
.task-status-awaiting_review { background: var(--color-info); }
.task-status-reviewed { background: var(--color-success); }
.task-status-cancelled { background: var(--color-text-tertiary); }

.task-content {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: 500;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.task-pond, .task-time {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.task-action {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* Alert List */
.alert-list {
  padding: 0 32rpx;
}

.alert-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
}

.alert-card.alert-high {
  background: #FFEBEE;
}

.alert-card.alert-medium {
  background: #FFF3E0;
}

.alert-card.alert-low {
  background: #E8F5E9;
}

.alert-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.alert-body {
  flex: 1;
}

.alert-text {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  display: block;
}

.alert-time {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
  display: block;
}

/* Favorite Ponds Scroll */
.pond-scroll {
  padding: 0 32rpx;
  white-space: nowrap;
}

.pond-card {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  padding: 24rpx;
  margin-right: 16rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  min-width: 240rpx;
}

.pond-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.pond-species {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}
