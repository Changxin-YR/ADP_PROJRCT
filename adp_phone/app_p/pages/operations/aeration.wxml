<view class="form-page">
  <view class="form-section">
    <view class="form-title">增氧记录</view>
    <view class="form-group"><text class="form-label">塘口 *</text><view class="form-picker" bindtap="selectPond"><text class="{{form.pondName ? 'picker-value' : 'picker-placeholder'}}">{{form.pondName || '请选择塘口'}}</text><text class="picker-arrow">›</text></view></view>
    <view class="form-group"><text class="form-label">设备类型</text><view class="weather-tags"><view class="tag {{form.deviceType === item ? 'tag-active' : ''}}" wx:for="{{deviceOptions}}" wx:key="*this" bindtap="selectDevice" data-value="{{item}}">{{item}}</view></view></view>
    <view class="form-group"><text class="form-label">操作</text><view class="weather-tags"><view class="tag {{form.action === item.value ? 'tag-active' : ''}}" wx:for="{{actionOptions}}" wx:key="value" bindtap="selectAction" data-value="{{item.value}}">{{item.label}}</view></view></view>
    <view class="form-group"><text class="form-label">运行时长(小时)</text><input class="form-input" type="digit" placeholder="" value="{{form.duration}}" bindinput="onInput" data-field="duration" /></view>
    <view class="form-group"><text class="form-label">备注</text><textarea class="form-textarea" placeholder="选填" value="{{form.remark}}" bindinput="onInput" data-field="remark" maxlength="200" /></view>
  </view>
  <view class="form-footer"><view class="btn-block btn-primary" bindtap="submit">提交记录</view></view>
</view>
