<view class="detail-page"><view class="section"><view class="section-title">投喂记录详情</view><view class="info-rows"><view class="info-row"><text class="info-label">塘口</text><text class="info-value">{{record.pondName}}</text></view><view class="info-row"><text class="info-label">饲料</text><text class="info-value">{{record.feedName}}</text></view><view class="info-row"><text class="info-label">实际投喂量</text><text class="info-value">{{record.amount}}{{record.unit}}</text></view><view class="info-row"><text class="info-label">投喂时间</text><text class="info-value">{{record.time}}</text></view><view class="info-row"><text class="info-label">天气</text><text class="info-value">{{record.weather || '--'}}</text></view><view class="info-row"><text class="info-label">吃食情况</text><text class="info-value">{{record.eatingStatusText || '--'}}</text></view><view class="info-row"><text class="info-label">操作人</text><text class="info-value">{{record.operator}}</text></view><view class="info-row" wx:if="{{record.remark}}"><text class="info-label">备注</text><text class="info-value">{{record.remark}}</text></view></view></view><view class="section" wx:if="{{record.photos.length > 0}}"><view class="section-title">现场照片</view><view class="photo-grid"><image wx:for="{{record.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="photo-img" bindtap="previewPhoto" data-url="{{item}}" /></view></view></view>
