<view class="detail-page"><view class="section"><view class="section-title">计划详情</view><view class="info-rows"><view class="info-row"><text class="info-label">塘口</text><text class="info-value">{{plan.pondName}}</text></view><view class="info-row"><text class="info-label">饲料</text><text class="info-value">{{plan.feedName}}</text></view><view class="info-row"><text class="info-label">计划量</text><text class="info-value">{{plan.amount}}{{plan.unit}}</text></view><view class="info-row"><text class="info-label">时间段</text><text class="info-value">{{plan.timeRange}}</text></view><view class="info-row"><text class="info-label">执行人</text><text class="info-value">{{plan.assignee || '--'}}</text></view><view class="info-row"><text class="info-label">状态</text><view class="badge badge-{{plan.statusColor}}">{{plan.statusText}}</view></view></view></view><view class="form-footer" wx:if="{{plan.canExecute}}"><view class="btn-block btn-primary" bindtap="startExecution">开始执行</view></view></view>
