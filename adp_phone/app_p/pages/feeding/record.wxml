<!--pages/feeding/record.wxml-->
<view class="record-page">
  <view class="offline-banner" wx:if="{{!isOnline}}">
    <text>离线模式 · 提交后将自动同步</text>
  </view>

  <view class="form-section">
    <view class="form-title">投喂记录</view>

    <!-- Pond Selection -->
    <view class="form-group">
      <text class="form-label">塘口 *</text>
      <view class="form-picker" bindtap="selectPond">
        <text class="{{form.pondName ? 'picker-value' : 'picker-placeholder'}}">{{form.pondName || '请选择塘口'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <!-- Feed Type -->
    <view class="form-group">
      <text class="form-label">饲料类型 *</text>
      <view class="form-picker" bindtap="selectFeedType">
        <text class="{{form.feedName ? 'picker-value' : 'picker-placeholder'}}">{{form.feedName || '请选择饲料'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <!-- Amount -->
    <view class="form-group">
      <text class="form-label">投喂量 *</text>
      <view class="form-input-row">
        <input class="form-input" type="digit" placeholder="请输入数量" value="{{form.amount}}" bindinput="onAmountChange" />
        <text class="form-unit">{{form.unit || 'kg'}}</text>
      </view>
    </view>

    <!-- Plan Amount Reference -->
    <view class="form-hint" wx:if="{{planAmount}}">
      计划投喂量：{{planAmount}}{{form.unit || 'kg'}}，偏差 {{deviationPercent}}%
    </view>

    <!-- Time -->
    <view class="form-group">
      <text class="form-label">投喂时间</text>
      <picker mode="time" value="{{form.time}}" bindchange="onTimeChange">
        <view class="form-picker">
          <text class="picker-value">{{form.time}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- Weather -->
    <view class="form-group">
      <text class="form-label">天气状况</text>
      <view class="weather-tags">
        <view class="tag {{form.weather === item ? 'tag-active' : ''}}" wx:for="{{weatherOptions}}" wx:key="*this" bindtap="selectWeather" data-value="{{item}}">
          {{item}}
        </view>
      </view>
    </view>

    <!-- Eating Observation -->
    <view class="form-group">
      <text class="form-label">吃食情况</text>
      <view class="weather-tags">
        <view class="tag {{form.eatingStatus === item.value ? 'tag-active' : ''}}" wx:for="{{eatingOptions}}" wx:key="value" bindtap="selectEating" data-value="{{item.value}}">
          {{item.label}}
        </view>
      </view>
    </view>

    <!-- Photos -->
    <view class="form-group">
      <text class="form-label">现场照片</text>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photos}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="photo-img" bindtap="previewPhoto" data-url="{{item}}" />
          <view class="photo-delete" catchtap="deletePhoto" data-index="{{index}}">×</view>
        </view>
        <view class="photo-add" bindtap="addPhoto" wx:if="{{photos.length < 6}}">
          <text class="photo-add-icon">+</text>
          <text class="photo-add-text">拍照/相册</text>
        </view>
      </view>
    </view>

    <!-- Remark -->
    <view class="form-group">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="请输入备注信息（选填）" value="{{form.remark}}" bindinput="onRemarkChange" maxlength="200" />
    </view>
  </view>

  <!-- Submit -->
  <view class="form-footer">
    <view class="btn-block btn-primary" bindtap="submitRecord">提交记录</view>
  </view>
</view>
