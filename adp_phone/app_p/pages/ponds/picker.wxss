.picker-page {
  min-height: 100vh;
  background: var(--color-bg-secondary);
}

.search-bar {
  padding: 16rpx 32rpx;
  background: var(--color-bg-primary);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-full);
}

.search-icon { font-size: 28rpx; }
.search-input { flex: 1; font-size: var(--font-sm); }

.pond-picker-list {
  padding: 16rpx 32rpx;
}

.pond-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
}

.pond-picker-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pond-picker-name {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--color-text-primary);
}

.pond-picker-area {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}
