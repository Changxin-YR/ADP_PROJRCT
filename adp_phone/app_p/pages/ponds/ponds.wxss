.ponds-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--color-bg-secondary);
}

/* Search */
.search-bar {
  padding: 16rpx 32rpx;
  background: var(--color-bg-primary);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-full);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-sm);
}

/* Status Filter */
.status-filter {
  padding: 16rpx 32rpx;
  white-space: nowrap;
  background: var(--color-bg-primary);
  border-bottom: 1rpx solid var(--color-border);
}

.filter-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg-secondary);
}

.chip-active {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* Pond List */
.pond-list {
  padding: 24rpx 32rpx;
}

.pond-card {
  background: var(--color-bg-elevated);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.pond-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pond-card-left {
  display: flex;
  flex-direction: column;
}

.pond-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.pond-area {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.pond-card-info {
  display: flex;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.pond-info-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-label {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.info-value {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  font-weight: 500;
}
