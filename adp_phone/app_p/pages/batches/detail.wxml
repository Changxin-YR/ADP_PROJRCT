<view class="detail-page"><view class="section"><view class="section-title">批次详情</view><view class="info-rows"><view class="info-row"><text class="info-label">批次编号</text><text class="info-value">{{batch.code}}</text></view><view class="info-row"><text class="info-label">塘口</text><text class="info-value">{{batch.pondName}}</text></view><view class="info-row"><text class="info-label">品种</text><text class="info-value">{{batch.species}}</text></view><view class="info-row"><text class="info-label">放养日期</text><text class="info-value">{{batch.stockingDate}}</text></view><view class="info-row"><text class="info-label">放养数量</text><text class="info-value">{{batch.stockingCount}}尾</text></view><view class="info-row"><text class="info-label">养殖天数</text><text class="info-value">{{batch.days}}天</text></view><view class="info-row"><text class="info-label">状态</text><view class="badge badge-{{batch.active ? 'success' : 'gray'}}">{{batch.active ? '进行中' : '已结束'}}</view></view></view></view></view>
