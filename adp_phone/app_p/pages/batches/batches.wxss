.batches-page { min-height: 100vh; background: var(--color-bg-secondary); }
.search-bar { padding: 16rpx 32rpx; background: var(--color-bg-primary); }
.search-input-wrap { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 24rpx; background: var(--color-bg-secondary); border-radius: var(--radius-full); }
.search-icon { font-size: 28rpx; }
.search-input { flex: 1; font-size: var(--font-sm); }
.batch-list { padding: 24rpx 32rpx; }
.batch-card { background: var(--color-bg-elevated); border-radius: var(--radius-lg); padding: 24rpx; margin-bottom: 16rpx; box-shadow: var(--shadow-sm); }
.batch-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.batch-code { font-size: var(--font-md); font-weight: 600; color: var(--color-text-primary); }
.batch-card-info { display: flex; gap: 32rpx; }
.batch-info-item { display: flex; flex-direction: column; gap: 4rpx; }
.info-label { font-size: var(--font-xs); color: var(--color-text-tertiary); }
.info-value { font-size: var(--font-sm); color: var(--color-text-primary); font-weight: 500; }
