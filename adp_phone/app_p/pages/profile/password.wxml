<!--pages/profile/password.wxml-->
<view class="password-page">
  <view class="form-section">
    <view class="form-title">修改密码</view>

    <view class="form-group">
      <text class="form-label">当前密码</text>
      <input class="form-input" type="text" password="{{!showOld}}" placeholder="请输入当前密码" value="{{oldPassword}}" bindinput="onOldInput" />
    </view>

    <view class="form-group">
      <text class="form-label">新密码</text>
      <input class="form-input" type="text" password="{{!showNew}}" placeholder="至少8位，包含字母和数字" value="{{newPassword}}" bindinput="onNewInput" />
    </view>

    <view class="form-group">
      <text class="form-label">确认新密码</text>
      <input class="form-input" type="text" password="{{!showConfirm}}" placeholder="再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmInput" />
    </view>

    <view class="form-hint" wx:if="{{error}}">
      <text class="error-text">{{error}}</text>
    </view>
  </view>

  <view class="form-footer">
    <view class="btn-block btn-primary" bindtap="submitChange">确认修改</view>
  </view>
</view>
