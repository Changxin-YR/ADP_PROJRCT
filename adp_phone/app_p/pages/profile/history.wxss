.history-page { min-height: 100vh; background: var(--color-bg-secondary); }
.filter-bar { display: flex; padding: 20rpx 32rpx; gap: 16rpx; background: var(--color-bg-primary); }
.filter-item { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx; background: var(--color-bg-secondary); border-radius: var(--radius-full); font-size: var(--font-sm); color: var(--color-text-secondary); }
.filter-arrow { font-size: 20rpx; color: var(--color-text-tertiary); }
.history-list { padding: 24rpx 32rpx; }
.history-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--color-border); }
.history-item:last-child { border-bottom: none; }
.history-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 8rpx; flex-shrink: 0; }
.history-dot-feeding { background: #2196F3; }
.history-dot-patrol { background: #4CAF50; }
.history-dot-requisition { background: #FF9800; }
.history-dot-medication { background: #9C27B0; }
.history-body { flex: 1; }
.history-title { font-size: var(--font-base); color: var(--color-text-primary); display: block; }
.history-meta { display: flex; gap: 16rpx; margin-top: 8rpx; font-size: var(--font-xs); color: var(--color-text-tertiary); }
