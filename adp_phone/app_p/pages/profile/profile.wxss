.profile-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--color-bg-secondary);
}

/* User Card */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx 32rpx 40rpx;
  background: var(--color-bg-primary);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar text {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 600;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.user-role {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.user-area {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* Stats */
.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  margin: 24rpx 32rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* Menu */
.menu-section {
  margin: 0 32rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text-primary);
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: var(--color-danger);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: var(--font-lg);
  color: var(--color-text-tertiary);
}

/* Logout */
.logout-section {
  padding: 48rpx 32rpx;
}

.btn-block {
  display: block;
  width: 100%;
  padding: 28rpx;
  text-align: center;
  border-radius: var(--radius-lg);
  font-size: var(--font-md);
  font-weight: 600;
}

.btn-danger-outline {
  background: transparent;
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
}
