.offline-page { min-height: 100vh; background: var(--color-bg-secondary); }
.form-section { margin: 24rpx 32rpx; background: var(--color-bg-elevated); border-radius: var(--radius-lg); padding: 32rpx; box-shadow: var(--shadow-sm); }
.form-title { font-size: var(--font-xl); font-weight: 700; color: var(--color-text-primary); margin-bottom: 24rpx; }
.offline-summary { text-align: center; padding: 32rpx 0; }
.offline-count { font-size: 72rpx; font-weight: 700; color: var(--color-primary); display: block; }
.offline-desc { font-size: var(--font-sm); color: var(--color-text-tertiary); }
.offline-list { margin-top: 24rpx; }
.offline-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--color-border); }
.offline-item:last-child { border-bottom: none; }
.offline-item-info { display: flex; flex-direction: column; gap: 4rpx; }
.offline-type { font-size: var(--font-base); color: var(--color-text-primary); }
.offline-time { font-size: var(--font-xs); color: var(--color-text-tertiary); }
.form-footer { padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.btn-block { display: block; width: 100%; padding: 28rpx; text-align: center; border-radius: var(--radius-lg); font-size: var(--font-md); font-weight: 600; }
.btn-primary { background: var(--color-primary); color: #FFFFFF; }
