.messages-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--color-bg-secondary);
}

.tab-bar {
  display: flex;
  background: var(--color-bg-primary);
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 20%;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--color-danger);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Message List */
.msg-list {
  padding: 16rpx 32rpx;
}

.msg-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-lg);
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.msg-unread {
  border-left: 4rpx solid var(--color-primary);
}

.msg-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.msg-title {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-time {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.msg-content {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.msg-tags {
  margin-top: 12rpx;
}

.msg-tag {
  padding: 4rpx 12rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}
