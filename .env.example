APP_ENV=development
FLASK_SECRET_KEY=change-this-development-secret
CSRF_SECRET_KEY=change-this-development-csrf-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=adp_auth
MYSQL_USER=adp_dev
MYSQL_PASSWORD=change-this-development-password
SESSION_COOKIE_SECURE=false
# 本地直连保持 0；仅当 Flask 前恰好有一层受控 Nginx 时设为 1。
TRUSTED_PROXY_HOPS=0
# 仅生产发布使用：必须先准备真实域名/证书，并由 deploy.sh 渲染 Nginx TLS 配置。
# ADP_SERVER_NAME=adp.example.com
# ADP_TLS_CERTIFICATE=/etc/letsencrypt/live/adp.example.com/fullchain.pem
# ADP_TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/adp.example.com/privkey.pem
VITE_DEMO_MODE=false
# Electron 桌面端构建时使用的 API 服务器地址，例如 https://adp.example.com；留空时浏览器使用同源 /api。
VITE_API_BASE_URL=
# 跨域桌面端来源白名单，Electron file:// 页面使用 null；多个来源用逗号分隔。生产跨域会话需 HTTPS + SESSION_COOKIE_SECURE=true。
ADP_CORS_ORIGINS=null
ATTACHMENT_ROOT=/var/lib/adp/attachments
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_CONFIRMATION_TTL_SECONDS=120
AGENT_SIDECAR_HOME=/var/lib/adp/agent-sidecar
AGENT_SIDECAR_CWD=/var/lib/adp
AGENT_SIDECAR_COMMAND=dsh
AGENT_SIDECAR_PATCH=backend/layers/features/agent/agent-restricted.patch.yml
# 生产环境建议配置固定的内部 Agent Gateway URL，避免信任请求 Host。
# AGENT_GATEWAY_URL=https://adp.example.com/api/v1/agent
